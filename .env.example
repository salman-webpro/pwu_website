# Copy this file to .env.local and fill in values.
# On Vercel, add the same names under Settings → Environment Variables.

# Public URL of the site (used for SEO metadata, sitemap, OG tags, email logo).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Form emails (Resend) ----------
# API key from https://resend.com/api-keys. Leave empty to only log submissions in the terminal.
RESEND_API_KEY=
# Sender. The domain must be verified in Resend. Before verifying, only
# "onboarding@resend.dev" works, and it can only send to your own Resend account email.
EMAIL_FROM=Print Wave USA <support@printwaveusa.com>
# Where form notifications go (defaults to support@printwaveusa.com).
EMAIL_TO=support@printwaveusa.com

# ---------- Future backend ----------
# Leave empty. When set, forms post here instead of using the built-in Resend emails.
NEXT_PUBLIC_API_BASE_URL=
